# Secrets and overrides for AI Autopilot (copy to .env or export in your shell).
# Anything here overrides config.yaml.

# Required: Claude authentication for the Agent SDK.
ANTHROPIC_API_KEY=sk-ant-...

# Azure DevOps — use ONE of: PAT, or OAuth app.
AUTOPILOT_ADO_PAT=
# AUTOPILOT_OAUTH_APP_ID=
# AUTOPILOT_OAUTH_APP_SECRET=

# Optional notification secrets.
# AUTOPILOT_ZALO_OA_ACCESS_TOKEN=
# AUTOPILOT_SMTP_PASSWORD=

# Optional: two-way Microsoft Teams bot (approve/reject buttons, chat commands).
# Requires `pip install .[teams-bot]` and teams_agent_enabled: true in config.yaml.
# app_id/tenant_id are not secret but the secret must never be committed — set here.
# AUTOPILOT_TEAMS_AGENT_APP_ID=
# AUTOPILOT_TEAMS_AGENT_APP_SECRET=
# AUTOPILOT_TEAMS_AGENT_TENANT_ID=

# Optional overrides (nested keys use __, e.g. a tenant PAT).
# AUTOPILOT_DRY_RUN=true
